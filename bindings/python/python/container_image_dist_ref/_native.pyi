from typing import List, Optional

__version__: str

class ParseError(ValueError):
    """Raised when a reference or component is invalid."""

    #: The Rust error variant, e.g. ``"PathInvalidChar"``.
    kind: str
    #: Byte index of the offending character, or the input length at EOF.
    index: int

class ImgRef:
    def __init__(self, src: str) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def domain(self) -> Optional[Domain]: ...
    @property
    def port(self) -> Optional[str]: ...
    @property
    def path(self) -> Path: ...
    @property
    def tag(self) -> Optional[Tag]: ...
    @property
    def digest(self) -> Optional[Digest]: ...
    def is_canonical(self) -> bool: ...
    def to_canonical(self) -> CanonicalImgRef: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...

class CanonicalImgRef:
    def __init__(self, src: str) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def domain(self) -> Domain: ...
    @property
    def port(self) -> Optional[str]: ...
    @property
    def path(self) -> Path: ...
    @property
    def tag(self) -> Optional[Tag]: ...
    @property
    def digest(self) -> Digest: ...
    def to_img_ref(self) -> ImgRef: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...

class Digest:
    def __init__(self, src: str) -> None: ...
    @property
    def algorithm(self) -> Algorithm: ...
    @property
    def encoded(self) -> Encoded: ...
    @property
    def compliance(self) -> str: ...
    def is_compliant_with(self, standard: str) -> bool: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...

class Algorithm:
    def __init__(self, src: str) -> None: ...
    @property
    def parts(self) -> List[str]: ...
    @property
    def compliance(self) -> str: ...
    def is_compliant_with(self, standard: str) -> bool: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...

class Encoded:
    def __init__(self, src: str, standard: Optional[str] = ...) -> None: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...

class Domain:
    def __init__(self, src: str) -> None: ...
    @property
    def host(self) -> Host: ...
    @property
    def port(self) -> Optional[str]: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...

class Host:
    def __init__(self, src: str) -> None: ...
    @property
    def kind(self) -> str: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...

class Path:
    def __init__(self, src: str) -> None: ...
    @property
    def parts(self) -> List[str]: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...

class Tag:
    def __init__(self, src: str) -> None: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...

def parse(reference: str) -> ImgRef: ...
def parse_canonical(reference: str) -> CanonicalImgRef: ...
def parse_digest(src: str) -> Digest: ...
def parse_algorithm(src: str) -> Algorithm: ...
def parse_encoded(src: str, standard: Optional[str] = ...) -> Encoded: ...
def parse_domain(src: str) -> Domain: ...
def parse_host(src: str) -> Host: ...
def parse_path(src: str) -> Path: ...
def parse_tag(src: str) -> Tag: ...
